{
    "name": "bigcartenergy/module-core",
    "description": "Big Cart Energy Core: the shared admin menu, configuration tab, brand assets and About section that every free Big Cart Energy module for Magento Open Source builds on. Does nothing on its own.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "homepage": "https://bigcartenergy.com",
    "authors": [
        {
            "name": "Big Cart Energy",
            "email": "hello@bigcartenergy.com"
        }
    ],
    "keywords": [
        "magento2",
        "magento 2",
        "big cart energy"
    ],
    "require": {
        "php": "~7.1.3 || ~7.2.0 || ~7.3.0 || ~7.4.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": "^102.0 || ^103.0",
        "magento/module-backend": "^101.0 || ^102.0",
        "magento/module-config": "^101.1"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BigCartEnergy\\Core\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "support": {
        "email": "hello@bigcartenergy.com",
        "issues": "https://github.com/bigcartenergy/module-core/issues",
        "source": "https://github.com/bigcartenergy/module-core"
    }
}
